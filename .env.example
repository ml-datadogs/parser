# Bright Data residential proxy
BRIGHTDATA_CUSTOMER=
BRIGHTDATA_ZONE=
BRIGHTDATA_PASSWORD=
BRIGHTDATA_HOST=brd.superproxy.io
BRIGHTDATA_PORT=33335
BRIGHTDATA_COUNTRY=
# Set to true after installing Bright Data SSL certificate
BRIGHTDATA_VERIFY_SSL=false
# Bright Data Web Unlocker (anti-bot). Set the API token to route sites with an
# unlocker_zone (e.g. litfund) through the Web Unlocker API instead of the
# residential proxy. Leave empty to disable and use residential only.
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_API_URL=https://api.brightdata.com/request

# ClickHouse (optional; pipeline/worker disabled when host is empty)
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=scraper
CLICKHOUSE_RAW_TABLE=raw_items
CLICKHOUSE_PARSED_TABLE=parsed_items
CLICKHOUSE_STATE_TABLE=parse_state
CLICKHOUSE_BATCH_SIZE=1000

# Parse worker
PARSE_BATCH_SIZE=1000

# Local file export
OUTPUT_DIR=output
